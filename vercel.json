{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ui && npm ci --install-links",
  "buildCommand": "python3 tools/build_site.py --generic",
  "outputDirectory": "ui/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(game.zip|version.json|worker.js)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "ignoreCommand": "test \"$VERCEL_GIT_COMMIT_REF\" != main"
}
