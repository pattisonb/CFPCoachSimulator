{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 -m teamdata.build_teams && python3 tools/build_site.py",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(game.zip|version.json|worker.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "ignoreCommand": "test \"$VERCEL_GIT_COMMIT_REF\" != main"
}
