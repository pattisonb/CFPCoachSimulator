{
  "name": "pocket-faces",
  "version": "0.3.0",
  "description": "Seeded 48x48 pixel-art faces from layered parts, stored as a small JSON per player.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "default": "./dist/data.js"
    },
    "./faces.json": "./faces.json",
    "./face.schema.json": "./face.schema.json"
  },
  "files": [
    "dist",
    "faces.json",
    "face.schema.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "build": "node scripts/sync.mjs && tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "license": "UNLICENSED"
}
