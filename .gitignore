.claude/
*.log

# (data/engine_teams.json and data/player_potential.json, the rosters, and data/base_meta.json, the teams' identities,
# are committed and are the thing itself: nothing makes them, and a rating is changed by changing it in the roster file)

# saves, custom coaches and a career's built leagues, when the game runs on Node against this folder
data/seasons/
data/coaches/
data/leagues/

# the long run's working files (tools/long_run.mjs); a finished run's seedN.json can be committed
data/long_run/check*.json
data/long_run/*.league.json
data/long_run/final*.json
data/long_run/*_[0-9]*.json
data/long_run/draft_pools.json

# other people's compilations fetched for fitting the game's models (ballots, recruiting classes, attendance,
# cached pages): kept local, never committed
data/ballots/
data/recruiting/
data/market/
data/cache/
data/history/cfbstats_cache/
data/analysis/
data/games.json
data/season_results.json

# the built site (node tools/build_site.mjs writes ui/dist/)
dist/

# skins (node tools/make_skin.mjs): a skin holds the names the published site must not carry, so one is never
# committed and never part of a build
skins/
*.skin.json
*.skin.json.gz
